FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
WORKDIR /app
COPY requirements-license.txt /app/requirements-license.txt
RUN pip install --no-cache-dir --require-hashes -r /app/requirements-license.txt
COPY src/fsm_license /app/src/fsm_license
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini
ENV PYTHONPATH=/app/src
RUN useradd --system --uid 10001 --no-create-home fsm
USER fsm
EXPOSE 8766
CMD ["sh", "-c", "alembic upgrade head && uvicorn fsm_license.app:app_factory --factory --host 0.0.0.0 --port 8766"]
