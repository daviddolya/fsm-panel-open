  "components": {
    "schemas": {
      "ActivationRequest": {
        "properties": {
          "activation_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 32,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Activation Key"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "device_public_key": {
            "type": "string",
            "maxLength": 44,
            "minLength": 43,
            "title": "Device Public Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activation_key",
          "installation_id",
          "device_public_key"
        ],
        "title": "ActivationRequest"
      },
      "EntitlementPut": {
        "properties": {
          "external_customer_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "External Customer Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "device_limit": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Device Limit"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "revoked"
            ],
            "title": "Status"
          },
          "revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Revision"
          },
          "rotate_activation_key": {
            "type": "boolean",
            "title": "Rotate Activation Key",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_customer_id",
          "expires_at",
          "device_limit",
          "status",
          "revision"
        ],
        "title": "EntitlementPut"
      },
      "EntitlementView": {
        "properties": {
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "external_customer_id": {
            "type": "string",
            "title": "External Customer Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "device_limit": {
            "type": "integer",
            "title": "Device Limit"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "active_devices": {
            "type": "integer",
            "title": "Active Devices"
          },
          "activation_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activation Key"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_id",
          "external_customer_id",
          "expires_at",
          "device_limit",
          "status",
          "revision",
          "active_devices",
          "changed"
        ],
        "title": "EntitlementView"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LicenseView": {
        "properties": {
          "activation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Activation Id"
          },
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "device_limit": {
            "type": "integer",
            "title": "Device Limit"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "lease": {
            "type": "string",
            "title": "Lease"
          },
          "renew_after_seconds": {
            "type": "integer",
            "title": "Renew After Seconds",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activation_id",
          "external_id",
          "expires_at",
          "device_limit",
          "revision",
          "lease"
        ],
        "title": "LicenseView"
      },
      "RenewRequest": {
        "properties": {
          "activation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Activation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "activation_id"
        ],
        "title": "RenewRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate service credential; never distributed to desktops."
      },
      "DeviceTimestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Timestamp",
        "description": "Unix seconds; must be within 30 seconds of server time."
      },
      "DeviceNonce": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Nonce",
        "description": "Fresh 32-100 character base64url nonce for each request."
      },
      "DeviceSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Signature",
        "description": "Base64url Ed25519 signature over UTF-8 FSM-PROOF-1, method, path plus raw query, timestamp, nonce, and hex SHA-256 of exact request bytes, separated by newline characters, with no trailing newline."
      }
    }
  }
}
