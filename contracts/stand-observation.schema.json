{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSM Panel stand observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "build_sha256", "machine", "steps", "expected", "actual", "status", "evidence"],
  "properties": {
    "feature_id": {"type": "string", "minLength": 1},
    "build_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "machine": {"type": "object", "minProperties": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected": {"type": "string", "minLength": 1},
    "actual": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object"},
    "operator_notes": {"type": "string"}
  }
}
