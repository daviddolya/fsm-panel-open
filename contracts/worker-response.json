{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fsm-panel:worker-response:v1",
  "title": "Steam worker JSON Lines response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "ok"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "account_id",
            "state",
            "offer_id",
            "code",
            "updated_at_ms",
            "simulation"
          ],
          "properties": {
            "operation_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "account_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "state": {
              "enum": [
                "not_sent",
                "created_pending_confirmation",
                "confirmed",
                "sent",
                "failed",
                "unknown_outcome"
              ]
            },
            "offer_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "code": {
              "enum": [
                null,
                "admission_expired",
                "admission_required",
                "auth_failed",
                "cancelled",
                "confirmation_unavailable",
                "confirmation_unknown",
                "cookies_failed",
                "deadline_exceeded",
                "duplicate_request",
                "frame_too_large",
                "interactive_auth_required",
                "internal_error",
                "invalid_inventory",
                "invalid_json",
                "invalid_request",
                "inventory_failed",
                "inventory_limit",
                "journal_error",
                "live_stand_required",
                "no_items",
                "operation_conflict",
                "operation_not_found",
                "pagination_loop",
                "partial_inventory",
                "protocol_version",
                "rate_limited",
                "recovered_after_restart",
                "request_limit",
                "send_unknown",
                "status_unavailable",
                "transport_lost",
                "unresolved_operation",
                "worker_busy"
              ]
            },
            "updated_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "simulation": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets",
            "failures",
            "simulation"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "app_id",
                  "context_id",
                  "asset_id",
                  "amount"
                ],
                "properties": {
                  "app_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "context_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            },
            "failures": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "app_id",
                  "context_id",
                  "code"
                ],
                "properties": {
                  "app_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "context_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "code": {
                    "enum": [
                      "admission_expired",
                      "admission_required",
                      "auth_failed",
                      "cancelled",
                      "confirmation_unavailable",
                      "confirmation_unknown",
                      "cookies_failed",
                      "deadline_exceeded",
                      "duplicate_request",
                      "frame_too_large",
                      "interactive_auth_required",
                      "internal_error",
                      "invalid_inventory",
                      "invalid_json",
                      "invalid_request",
                      "inventory_failed",
                      "inventory_limit",
                      "journal_error",
                      "live_stand_required",
                      "no_items",
                      "operation_conflict",
                      "operation_not_found",
                      "pagination_loop",
                      "partial_inventory",
                      "protocol_version",
                      "rate_limited",
                      "recovered_after_restart",
                      "request_limit",
                      "send_unknown",
                      "status_unavailable",
                      "transport_lost",
                      "unresolved_operation",
                      "worker_busy"
                    ]
                  }
                }
              }
            },
            "simulation": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cancelled"
          ],
          "properties": {
            "cancelled": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "account_id",
            "state",
            "code",
            "updated_at_ms",
            "simulation",
            "granted_app_ids"
          ],
          "properties": {
            "operation_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "account_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "state": {
              "enum": [
                "not_started",
                "warming_up",
                "playing",
                "completed",
                "cancelled",
                "failed",
                "unknown_outcome"
              ]
            },
            "code": {
              "enum": [
                null,
                "admission_expired",
                "admission_required",
                "auth_failed",
                "cancelled",
                "confirmation_unavailable",
                "confirmation_unknown",
                "cookies_failed",
                "deadline_exceeded",
                "duplicate_request",
                "frame_too_large",
                "interactive_auth_required",
                "internal_error",
                "invalid_inventory",
                "invalid_json",
                "invalid_request",
                "inventory_failed",
                "inventory_limit",
                "journal_error",
                "live_stand_required",
                "no_items",
                "operation_conflict",
                "operation_not_found",
                "pagination_loop",
                "partial_inventory",
                "protocol_version",
                "rate_limited",
                "recovered_after_restart",
                "request_limit",
                "send_unknown",
                "status_unavailable",
                "transport_lost",
                "unresolved_operation",
                "worker_busy"
              ]
            },
            "updated_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "simulation": {
              "type": "boolean"
            },
            "granted_app_ids": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "renewed"
          ],
          "properties": {
            "renewed": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "admission_expired",
            "admission_required",
            "auth_failed",
            "cancelled",
            "confirmation_unavailable",
            "confirmation_unknown",
            "cookies_failed",
            "deadline_exceeded",
            "duplicate_request",
            "frame_too_large",
            "interactive_auth_required",
            "internal_error",
            "invalid_inventory",
            "invalid_json",
            "invalid_request",
            "inventory_failed",
            "inventory_limit",
            "journal_error",
            "live_stand_required",
            "no_items",
            "operation_conflict",
            "operation_not_found",
            "pagination_loop",
            "partial_inventory",
            "protocol_version",
            "rate_limited",
            "recovered_after_restart",
            "request_limit",
            "send_unknown",
            "status_unavailable",
            "transport_lost",
            "unresolved_operation",
            "worker_busy"
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ]
}
