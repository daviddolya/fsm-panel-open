{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fsm-panel:worker-response:v1",
  "title": "Steam worker JSON Lines response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "ok"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "account_id",
            "state",
            "offer_id",
            "code",
            "updated_at_ms",
            "simulation"
          ],
          "properties": {
            "operation_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "account_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
            },
            "state": {
              "enum": [
                "not_sent",
                "created_pending_confirmation",
                "confirmed",
                "sent",
                "failed",
                "unknown_outcome"
              ]
            },
            "offer_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Fixed public worker code; arbitrary text is rejected."
            },
            "updated_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "simulation": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets",
            "failures",
            "simulation"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "app_id",
                  "context_id",
                  "asset_id",
                  "amount"
                ],
                "properties": {
                  "app_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "context_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              }
            },
            "failures": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "app_id",
                  "context_id",
                  "code"
                ],
                "properties": {
                  "app_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "context_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "simulation": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cancelled"
          ],
          "properties": {
            "cancelled": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ]
}
