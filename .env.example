# Copy to an ignored .env. Generate secrets with: python -m fsm_license.keys
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD
FSM_LICENSE_INTERNAL_TOKEN=REPLACE_WITH_GENERATED_SERVICE_TOKEN
FSM_LICENSE_SIGNING_KEY=REPLACE_WITH_GENERATED_BASE64URL_PRIVATE_KEY
FSM_LICENSE_PUBLIC_KEY=REPLACE_WITH_GENERATED_BASE64URL_PUBLIC_KEY
FSM_LICENSE_ISSUER=fsm-license
FSM_LICENSE_AUDIENCE=fsm-panel
FSM_LICENSE_KEY_ID=license-v1
# For running outside Compose, configure the dedicated PostgreSQL connection:
# FSM_LICENSE_DATABASE_URL=postgresql+psycopg://fsm_license:PASSWORD@localhost/fsm_license
FSM_LICENSE_URL=https://license.example.invalid
